---
interface Props {
  text?: string;
  size?: 'sm' | 'md';
  pulse?: boolean;
  class?: string;
}

const {
  text = 'Dates TBA',
  size = 'md',
  pulse = true,
  class: className = '',
} = Astro.props;

const sizeStyles = {
  sm: 'px-2.5 py-0.5 text-xs',
  md: 'px-3 py-1 text-xs sm:text-sm',
};
---

<span class={`inline-flex items-center gap-1.5 font-mono font-medium rounded-full bg-brand-500/10 border border-brand-500/30 text-brand-300 shadow-glow-sm backdrop-blur-sm ${sizeStyles[size]} ${className}`}>
  {pulse && (
    <span class="relative flex h-2 w-2">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-500"></span>
    </span>
  )}
  <span>{text}</span>
</span>
