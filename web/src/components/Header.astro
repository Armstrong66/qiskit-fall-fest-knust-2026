---
import { siteConfig } from '../site.config';
import Button from './ui/Button.astro';
---

<header class="sticky top-0 z-50 w-full px-4 sm:px-6 lg:px-8 py-3 transition-all duration-300">
  <div class="max-w-7xl mx-auto">
    <div class="glass-panel rounded-2xl px-4 sm:px-6 py-2.5 flex items-center justify-between border border-white/10 bg-[#0d1117]/80 shadow-glass">
      
      <!-- Brand Logo / Identity -->
      <a href="#" class="flex items-center gap-3 group">
        <!-- Dual Brand Lockup: Qiskit Emblem + KNUST Crest -->
        <div class="flex items-center gap-1.5">
          <div class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-brand-500/10 border border-brand-500/30 group-hover:border-brand-400 group-hover:shadow-glow-sm transition-all duration-300 shrink-0">
            <img 
              src="/assets/qff-global/badge-pink.svg" 
              alt="Qiskit Emblem" 
              class="w-6 h-6 transform group-hover:scale-110 transition-transform duration-300"
            />
          </div>
          <div class="relative flex items-center justify-center w-9 h-9 rounded-xl bg-white/[0.04] border border-white/10 p-1 shrink-0">
            <img 
              src="/assets/knust/knust-logo.png" 
              alt="KNUST Crest" 
              class="w-full h-full object-contain"
            />
          </div>
        </div>

        <div class="flex flex-col">
          <span class="text-sm sm:text-base font-bold tracking-tight text-white flex items-center gap-1.5 font-sans">
            Qiskit Fall Fest
            <span class="px-1.5 py-0.2 rounded text-[10px] font-mono font-semibold bg-brand-500/20 text-brand-300 border border-brand-500/30">
              2026
            </span>
          </span>
          <span class="text-xs text-carbon-400 font-mono tracking-wider">KNUST CHAPTER</span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
        {siteConfig.nav.map((item) => (
          <a
            href={item.href}
            class="text-carbon-300 hover:text-white transition-colors duration-200 py-1 border-b-2 border-transparent hover:border-brand-400"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Action Buttons -->
      <div class="hidden sm:flex items-center gap-3">
        <Button
          href={siteConfig.links.register}
          variant="primary"
          size="sm"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Register</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17l9.2-9.2M17 17V7H7"/>
          </svg>
        </Button>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex sm:hidden items-center">
        <button
          id="mobile-menu-toggle"
          type="button"
          class="p-2 rounded-lg text-carbon-300 hover:text-white hover:bg-white/5 focus:outline-none"
          aria-label="Toggle Navigation Menu"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="hidden w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobile-menu" class="hidden sm:hidden mt-2 p-4 glass-panel rounded-2xl border border-white/10 bg-[#0d1117]/95 shadow-glass space-y-3">
      <nav class="flex flex-col space-y-2">
        {siteConfig.nav.map((item) => (
          <a
            href={item.href}
            class="px-3 py-2 rounded-lg text-carbon-300 hover:text-white hover:bg-brand-500/10 transition-colors text-sm font-medium"
          >
            {item.label}
          </a>
        ))}
      </nav>
      <div class="pt-2 border-t border-white/10">
        <Button
          href={siteConfig.links.register}
          variant="primary"
          size="md"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full"
        >
          <span>Register on Luma</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17l9.2-9.2M17 17V7H7"/>
          </svg>
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && mobileMenu && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = mobileMenu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden', !isExpanded);
      iconClose.classList.toggle('hidden', isExpanded);
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });
  }
</script>
