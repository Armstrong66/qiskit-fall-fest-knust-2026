---
import teamData from '../data/team.json';
import SectionHeading from './ui/SectionHeading.astro';
---

<section id="organizers" class="py-20 sm:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <SectionHeading
      badge="Student Leadership"
      title={teamData.sectionTitle}
      subtitle={teamData.sectionSubtitle}
    />

    <!-- 5 Organizers Grid Container with Disciplined Dimensions -->
    <!-- On desktop: 5-column responsive grid with fixed containment to prevent any misalignment or overflow -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 sm:gap-6 items-stretch justify-center">
      {teamData.organizers.map((member) => (
        <div class="interactive-focus-target group relative rounded-2xl bg-[#121722]/80 backdrop-blur-xl border border-white/[0.08] hover:border-brand-500/50 p-6 flex flex-col items-center text-center justify-between transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_0_30px_rgba(138,63,252,0.22)]">
          
          <!-- Subtle Top Highlight Line -->
          <div class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-brand-400/30 to-transparent"></div>

          <!-- Top Block: Headshot + Primary Info -->
          <div class="flex flex-col items-center w-full">
            
            <!-- Headshot Container with Hardcoded Fixed Aspect Ratio & Glow -->
            <div class="relative w-28 h-28 sm:w-32 sm:h-32 mb-5 rounded-full p-1 bg-linear-to-br from-brand-500/40 via-quantum-cyan/30 to-brand-700/40 group-hover:from-brand-400 group-hover:to-quantum-cyan transition-all duration-300 shadow-glow-sm shrink-0">
              <div class="w-full h-full rounded-full overflow-hidden bg-[#161b22] flex items-center justify-center relative">
                
                <!-- Headshot Image -->
                <img
                  src={member.image}
                  alt={member.name}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  onerror={`this.style.display='none'; this.nextElementSibling.style.display='flex';`}
                />

                <!-- Fallback Initials Avatar Badge (renders if image fails or before custom photo is uploaded) -->
                <div 
                  class="hidden w-full h-full items-center justify-center bg-linear-to-br from-[#161b22] to-[#21262d] text-brand-300 font-mono font-bold text-xl"
                  aria-hidden="true"
                >
                  {member.initials}
                </div>

              </div>

              <!-- Quantum Active Indicator Dot -->
              <span class="absolute bottom-1 right-1 w-4 h-4 rounded-full bg-emerald-500 border-2 border-[#0a0d14] shadow-sm"></span>
            </div>

            <!-- Organizer Name -->
            <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-brand-300 transition-colors tracking-tight line-clamp-1 mb-1">
              {member.name}
            </h3>

            <!-- Role Badge / Title -->
            <div class="min-h-[44px] flex items-center justify-center">
              <span class="text-xs font-mono font-semibold text-quantum-cyan leading-snug">
                {member.role}
              </span>
            </div>

            <!-- Department / Unit -->
            <div class="min-h-[36px] flex items-center justify-center mt-1 mb-2">
              <p class="text-[11px] text-carbon-400 font-sans line-clamp-2 leading-tight">
                {member.department}
              </p>
            </div>

            <!-- Bio snippet -->
            <p class="text-xs text-carbon-300 leading-relaxed font-normal line-clamp-3 mb-4 min-h-[54px] flex items-center justify-center">
              {member.bio}
            </p>

          </div>

          <!-- Bottom Block: Social Profiles & Chapter Credit -->
          <div class="w-full pt-4 border-t border-white/[0.06] flex items-center justify-center gap-3 text-carbon-400">
            {member.socials.linkedin && (
              <a
                href={member.socials.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="p-1.5 rounded-lg hover:text-brand-300 hover:bg-brand-500/10 transition-colors"
                aria-label={`${member.name} LinkedIn`}
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45c-.9 0-1.63.73-1.63 1.63 0 .9.73 1.63 1.63 1.63.9 0 1.63-.73 1.63-1.63 0-.9-.73-1.63-1.63-1.63Z"/>
                </svg>
              </a>
            )}

            {member.socials.twitter && (
              <a
                href={member.socials.twitter}
                target="_blank"
                rel="noopener noreferrer"
                class="p-1.5 rounded-lg hover:text-brand-300 hover:bg-brand-500/10 transition-colors"
                aria-label={`${member.name} Twitter / X`}
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            )}

            {member.socials.github && (
              <a
                href={member.socials.github}
                target="_blank"
                rel="noopener noreferrer"
                class="p-1.5 rounded-lg hover:text-brand-300 hover:bg-brand-500/10 transition-colors"
                aria-label={`${member.name} GitHub`}
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
              </a>
            )}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
