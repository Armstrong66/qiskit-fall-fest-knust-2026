---
import scheduleData from '../data/schedule.json';
import SectionHeading from './ui/SectionHeading.astro';
import GlowCard from './ui/GlowCard.astro';
---

<section id="schedule" class="py-20 sm:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <SectionHeading
      title="Workshop & Hackathon Schedule"
      subtitle="Structured learning pathways from fundamentals to quantum application development."
    />

    {scheduleData.isTbd ? (
      <div class="space-y-8">
        
        <div class="glass-panel rounded-2xl p-6 sm:p-8 border border-brand-500/30 bg-[#121722]/80 text-center max-w-3xl mx-auto">
          <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">
            Full Daily Timetable Releasing Soon
          </h3>

          <p class="text-carbon-300 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
            {scheduleData.tbdNotice}
          </p>
        </div>

        <div class="mt-12">
          <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-carbon-400 text-center mb-6">
            Planned Workshop & Track Focus Areas
          </h4>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {scheduleData.tracks.map((track, i) => (
              <GlowCard glowColor="purple" class="flex flex-col justify-between">
                <div>
                  <div class="w-8 h-8 rounded-lg bg-brand-500/10 border border-brand-500/30 flex items-center justify-center text-xs font-mono font-bold text-brand-300 mb-4">
                    0{i + 1}
                  </div>

                  <h5 class="text-lg font-bold text-white mb-2">
                    {track.name}
                  </h5>

                  <p class="text-xs sm:text-sm text-carbon-300 leading-relaxed">
                    {track.description}
                  </p>
                </div>

                <div class="mt-4 pt-3 border-t border-white/[0.05] text-[11px] font-mono text-brand-400">
                  Track 0{i + 1} Module
                </div>
              </GlowCard>
            ))}
          </div>
        </div>

      </div>
    ) : (
      <div class="space-y-6">
        {scheduleData.days.map((day) => (
          <GlowCard class="p-6">
            <h3 class="text-xl font-bold text-white mb-4">
              {day.title}
            </h3>
          </GlowCard>
        ))}
      </div>
    )}

  </div>
</section>