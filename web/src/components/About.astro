---
import aboutData from '../data/about.json';
import SectionHeading from './ui/SectionHeading.astro';
import GlowCard from './ui/GlowCard.astro';
---

<section id="about" class="py-20 sm:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <SectionHeading
      title="Uniting Quantum Builders & Scholars"
      subtitle="From foundational quantum mechanics to quantum programming on real QPUs."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
      
      <!-- Card 1: Global Initiative -->
      <GlowCard glowColor="purple" class="flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-end mb-6">
            <img src="/assets/qff-global/badge-pink.svg" alt="Qiskit Global" class="w-7 h-7" />
          </div>

          <h3 class="text-2xl font-bold text-white mb-4">
            {aboutData.global.title}
          </h3>

          <p class="text-carbon-300 leading-relaxed mb-6">
            {aboutData.global.description}
          </p>
        </div>

        <div class="pt-6 border-t border-white/[0.08] space-y-3">
          <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-carbon-400">Key Highlights</h4>
          <ul class="space-y-2 text-sm text-carbon-200">
            {aboutData.global.highlights.map((highlight) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-brand-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        </div>
      </GlowCard>

      <!-- Card 2: KNUST Chapter & Physics Unit -->
      <GlowCard glowColor="cyan" class="flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-end mb-6">
            <div class="w-9 h-9 rounded-xl bg-white/[0.05] border border-white/10 p-1 flex items-center justify-center">
              <img src="/assets/knust/knust-logo.png" alt="KNUST Logo" class="w-full h-full object-contain" />
            </div>
          </div>

          <h3 class="text-2xl font-bold text-white mb-2">
            {aboutData.knustChapter.title}
          </h3>
          <p class="text-xs font-mono text-carbon-400 mb-4">
            {aboutData.knustChapter.department} · {aboutData.knustChapter.institution}
          </p>

          <p class="text-carbon-300 leading-relaxed mb-6">
            {aboutData.knustChapter.description}
          </p>
        </div>

        <div class="pt-6 border-t border-white/[0.08] grid grid-cols-3 gap-4">
          {aboutData.knustChapter.stats.map((stat) => (
            <div class="flex flex-col items-center text-center p-3 rounded-xl bg-white/[0.03] border border-white/[0.05]">
              <span class="text-lg sm:text-xl font-bold font-mono text-white text-gradient-cyan">{stat.value}</span>
              <span class="text-[11px] text-carbon-400 mt-0.5">{stat.label}</span>
            </div>
          ))}
        </div>
      </GlowCard>

    </div>
  </div>
</section>
