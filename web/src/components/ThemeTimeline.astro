---
import themeData from '../data/theme.json';
import SectionHeading from './ui/SectionHeading.astro';
import GlowCard from './ui/GlowCard.astro';
---

<section id="theme" class="py-20 sm:py-28 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <SectionHeading
      title={themeData.title}
      subtitle={themeData.tagline}
    />

    <!-- Theme Narrative Banner -->
    <div class="mb-16">
      <GlowCard glowColor="purple" class="relative">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8">
            <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">
              The Journey to Quantum Utility
            </h3>
            <p class="text-carbon-300 text-sm sm:text-base leading-relaxed">
              {themeData.overview}
            </p>

            <div class="mt-5">
              <a
                href="/assets/docs/A Decade in the Cloud_ The Evolution of Quantum Computing.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-brand-500/10 border border-brand-500/30 text-brand-300 hover:text-white hover:bg-brand-500/20 hover:border-brand-400 transition-all text-xs font-mono group"
              >
                <svg class="w-4 h-4 text-quantum-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
                <span>Read Decade Theme Paper (PDF)</span>
                <svg class="w-3.5 h-3.5 text-carbon-400 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            </div>
          </div>
          <div class="lg:col-span-4 flex items-center justify-center p-2">
            <div class="relative flex items-center justify-center w-full max-w-[200px]">
              <img 
                src="/assets/qff-global/Fall Fest.png" 
                alt="Fall Fest Decade Badge" 
                class="w-full h-auto object-contain drop-shadow-xl"
              />
            </div>
          </div>
        </div>
      </GlowCard>
    </div>

    <!-- Timeline Grid: 2016 to 2026 -->
    <div class="relative">
      <!-- Central connecting line on desktop -->
      <div class="hidden lg:block absolute top-1/2 left-0 right-0 h-0.5 bg-linear-to-r from-brand-600 via-quantum-cyan to-brand-500 -translate-y-1/2 opacity-30 z-0"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 relative z-10">
        {themeData.milestones.map((milestone, idx) => (
          <div class="interactive-focus-target group relative rounded-2xl bg-[#121722]/80 backdrop-blur-md border border-white/[0.08] p-6 hover:border-brand-400/50 hover:bg-[#182030]/90 transition-all duration-300 flex flex-col justify-between">
            
            <div>
              <!-- Year & Qubit marker -->
              <div class="flex items-center justify-between mb-4">
                <span class="text-2xl font-extrabold font-mono text-gradient-purple">
                  {milestone.year}
                </span>
                <span class="w-8 h-8 rounded-full bg-white/[0.04] border border-white/10 flex items-center justify-center text-xs font-mono text-carbon-300 group-hover:border-quantum-cyan/60 group-hover:text-quantum-cyan transition-colors">
                  0{idx + 1}
                </span>
              </div>

              <!-- Milestone Title -->
              <h4 class="text-base font-bold text-white mb-2 group-hover:text-brand-300 transition-colors">
                {milestone.title}
              </h4>

              <!-- Milestone Details -->
              <p class="text-xs sm:text-sm text-carbon-300 leading-relaxed">
                {milestone.summary}
              </p>
            </div>

          </div>
        ))}
      </div>
    </div>

  </div>
</section>
