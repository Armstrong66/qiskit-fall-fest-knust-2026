---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  target?: string;
  rel?: string;
  class?: string;
  id?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  target,
  rel,
  class: className = '',
  id,
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium transition-all duration-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-[#0a0d14] disabled:opacity-50 disabled:pointer-events-none cursor-pointer';

const sizeStyles = {
  sm: 'px-3.5 py-1.5 text-xs font-mono tracking-wide gap-1.5',
  md: 'px-5 py-2.5 text-sm gap-2',
  lg: 'px-7 py-3.5 text-base font-semibold gap-2.5 shadow-lg',
};

const variantStyles = {
  primary: 'bg-gradient-to-r from-brand-600 via-brand-500 to-quantum-cyan text-white hover:shadow-glow-md hover:brightness-110 active:scale-[0.98] border border-brand-400/30 focus:ring-brand-400',
  secondary: 'bg-[#161b22]/90 text-carbon-100 hover:text-white border border-white/10 hover:border-brand-500/50 hover:bg-[#21262d] active:scale-[0.98] focus:ring-brand-500',
  outline: 'bg-transparent text-carbon-100 hover:text-white border border-brand-500/40 hover:border-brand-400 hover:bg-brand-500/10 active:scale-[0.98] focus:ring-brand-400',
  ghost: 'bg-transparent text-carbon-300 hover:text-white hover:bg-white/5 active:scale-[0.98] focus:ring-brand-500',
};

const classes = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
const isLink = !!href;
---

{
  isLink ? (
    <a href={href} target={target} rel={rel} class={classes} id={id}>
      <slot />
    </a>
  ) : (
    <button class={classes} id={id}>
      <slot />
    </button>
  )
}
